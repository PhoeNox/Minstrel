@page "/"
@using KristofferStrube.Blazor.WebAudio
@inject IJSRuntime JsRuntime

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new Fluent Blazor app.

@code {
	private AudioContext context = null!;
	private AudioDestinationNode destination = null!;
	
	protected override async Task OnInitializedAsync()
	{
		context = await AudioContext.CreateAsync(JsRuntime);
		destination = await context.GetDestinationAsync();
		
		var buffer = await File.ReadAllBytesAsync("Music/Day/Clocktower Ambience.mp3");
		var audioBuffer = await context.DecodeAudioDataAsync(buffer);

		var audioBufferNode = await context.CreateBufferSourceAsync();
		await audioBufferNode.SetBufferAsync(audioBuffer);
		await audioBufferNode.ConnectAsync(destination);
		await audioBufferNode.StartAsync();
	}
}