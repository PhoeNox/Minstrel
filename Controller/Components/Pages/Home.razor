@page "/"
@using Controller.Playlist
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject IState<Controller.Game.State> GameState
@inject IState<State> PlaylistState

<PageTitle>Home</PageTitle>

@if (GamePhase is null)
{
	<p>Loading...</p>
}
else
{
	<h1>@GamePhase</h1>
}

@if (Playlist is null)
{
	<p>Loading...</p>
}
else
{
	<ul>
		@foreach (var song in Playlist.Songs)
		{
			<li>@song.Title</li>
		}
	</ul>
}

@code {
	Playlist? Playlist => PlaylistState.Value.Playlist;
	GamePhase? GamePhase => GameState.Value.GamePhase;
	
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		Dispatcher.Dispatch(new UpdatePlaylistAction());
	}
}