@page "/"
@using Controller.Playlist
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject IState<Controller.Game.State> GameState
@inject IState<State> PlaylistState

<PageTitle>Home</PageTitle>

@if (GamePhase is null)
{
	<p>Loading...</p>
}
else
{
	<h1>@GamePhase</h1>
}

@if (Playlists is null)
{
	<p>Loading...</p>
}
else
{
	<ul>
		@foreach (var song in Playlists.DayPlaylist.Songs)
		{
			<li>@song.Title @song.Artist @song.Album @song.Length</li>
		}
	</ul>
}

@code {
	Playlists? Playlists => PlaylistState.Value.Playlists;
	GamePhase? GamePhase => GameState.Value.GamePhase;
	
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		Dispatcher.Dispatch(new UpdatePlaylistAction());
	}
}