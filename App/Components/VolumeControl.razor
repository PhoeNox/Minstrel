@using System.Globalization

<input 
	type="range" min="0" max="2" step="0.1"
	value="@Gain.ToString(CultureInfo.InvariantCulture)"
	@oninput="OnGainChanged"/>

@code {
	[Parameter]
	public double Gain { get; set; }
	
	[Parameter] 
	public EventCallback<double> GainChanged { get; set; }

	[Parameter] 
	public string Class { get; set; } = string.Empty;

	private async Task OnGainChanged(ChangeEventArgs obj)
	{
		var value = (string) obj.Value!;
		var valueAsDouble = double.Parse(value, CultureInfo.InvariantCulture);
		await GainChanged.InvokeAsync(valueAsDouble);
	}
}
