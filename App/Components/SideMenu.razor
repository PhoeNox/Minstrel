@using Features.GamePhases
@using Features.QrCodeConnection
@using Features.Timer
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IDispatcher Dispatcher
@inject IState<Features.GamePhases.State> GamePhaseState
@inject IState<Features.Timer.State> TimerState
@inject IState<Features.QrCodeConnection.State> QrCodeConnectionState
@inject IState<Features.Playback.State> PlaybackState
@inject IState<Features.Playlists.State> PlaylistState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

@if (isOpen)
{
	<div class="menu-overlay" @onclick="Close"></div>
}

<div class="side-menu @(isOpen ? "open" : "")">
	
	<button @onclick="GoToPlaylistManagement" >Manage playlists</button>
	
	<div>
		@if (PlaybackState.Value.IsPlaying)
		{
			<button @onclick="Pause">⏸ Pause</button>
		}
		else
		{
			<button
				class="@(!PlaybackState.Value.IsPlaying ? "primary" : "")"
				disabled="@(PlaylistState.Value.DayPlaylist.CurrentSong is null
									|| !PlaybackState.Value.LoadedSongs.Contains(PlaylistState.Value.DayPlaylist.CurrentSong))"
				@onclick="Play">
				▶ Play
			</button>
		}

		<button
			class="@(PlaybackState.Value.IsPlaying && IsSongOnOtherPlaylistAvailable ? "primary" : "")"
			disabled="@(!PlaybackState.Value.IsPlaying || !IsSongOnOtherPlaylistAvailable)"
			@onclick="SwitchGamePhase">
			<Icon Name="IconName.BrightnessAltHighFill"/>
			Switch
		</button>
	</div>

	<div>
		@if (TimerState.Value.IsRunning)
		{
			<label class="timer">@TimerState.Value.TimeLeft.ToString(@"mm\:ss")</label>
			<button @onclick="StopTimer">⏹ Stop Timer</button>
		}
		else
		{
			<button @onclick="OpenTimerDialog">⏱ Start Timer</button>
		}
	</div>

	<div>
		@if (QrCodeConnectionState.Value.QrCodeVisibility != QrCodeVisibility.Hidden)
		{
			<button @onclick="HideQrCode">⧉ Hide QR Code</button>
		}
		else
		{
			<button @onclick="ShowQrCode">⧉ Show QR Code</button>
		}
	</div>
</div>

<dialog @ref="timerDialog">
	<h3>Start Timer</h3>
	<div>
		<input type="number" id="timerMinutes" min="1" @bind="timerMinutes"/>
		<label for="timerMinutes">Minutes</label>
	</div>
	<div>
		<button class="primary" @onclick="StartTimerFromDialog">Start Timer</button>
		<button @onclick="CloseTimerDialog">Cancel</button>
	</div>
</dialog>

@code {
	bool isOpen;
	int timerMinutes = 5;
	ElementReference timerDialog;

	bool IsSongOnOtherPlaylistAvailable
		=> PlaybackState.Value.IsSongOnOtherPlaylistAvailable(PlaylistState.Value, GamePhaseState.Value);

	public void Toggle()
	{
		isOpen = !isOpen;
		StateHasChanged();
	}

	void Close()
	{
		isOpen = false;
		StateHasChanged();
	}

	void Play()
	{
		Dispatcher.Dispatch(new Features.Playback.PlayAction());
		Close();
	}

	void Pause()
	{
		Dispatcher.Dispatch(new Features.Playback.PauseAction());
		Close();
	}

	void SwitchGamePhase()
	{
		Dispatcher.Dispatch(new SwitchGamePhaseAction());
		Close();
	}

	async Task OpenTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("showModal", timerDialog);
		Close();
	}

	async Task CloseTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("closeModal", timerDialog);
	}

	async Task StartTimerFromDialog()
	{
		var timerDuration = TimeSpan.FromMinutes(timerMinutes);
		if (timerDuration > TimeSpan.Zero)
			Dispatcher.Dispatch(new StartTimerAction(timerDuration));
		await CloseTimerDialog();
	}

	void StopTimer()
	{
		Dispatcher.Dispatch(new SetIsTimeRunningAction(false));
		Close();
	}

	void ShowQrCode()
	{
		Dispatcher.Dispatch(new ShowQrCodeAction());
		Close();
	}

	void HideQrCode()
	{
		Dispatcher.Dispatch(new HideQrCodeAction());
		Close();
	}

	void GoToPlaylistManagement()
	{
		NavigationManager.NavigateTo("/playlists");
	}
}
