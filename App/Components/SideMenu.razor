@using Features.QrCodeConnection
@using Features.Timer
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IDispatcher Dispatcher
@inject IState<Features.Timer.State> TimerState
@inject IState<Features.QrCodeConnection.State> QrCodeConnectionState
@inject IJSRuntime JsRuntime

@if (isOpen)
{
	<div class="menu-overlay" @onclick="Close"></div>
}

<div class="side-menu @(isOpen ? "open" : "")">
	@if (TimerState.Value.IsRunning)
	{
		<button @onclick="StopTimer">⏹ Stop Timer</button>
	}
	else
	{
		<button @onclick="OpenTimerDialog">⏱ Start Timer</button>
	}

	@if (QrCodeConnectionState.Value.QrCodeVisibility != QrCodeVisibility.Hidden)
	{
		<button @onclick="HideQrCode">⧉ Hide QR Code</button>
	}
	else
	{
		<button @onclick="ShowQrCode">⧉ Show QR Code</button>
	}
</div>

<dialog id="timerDialog">
	<h3>Start Timer</h3>
	<div>
		<input type="number" id="timerMinutes" min="1" @bind="timerMinutes"/>
		<label for="timerMinutes">Minutes</label>
	</div>
	<div>
		<button class="primary" @onclick="StartTimerFromDialog">Start Timer</button>
		<button @onclick="CloseTimerDialog">Cancel</button>
	</div>
</dialog>

@code {
	bool isOpen;
	int timerMinutes = 8;

	public void Toggle()
	{
		isOpen = !isOpen;
		StateHasChanged();
	}

	void Close()
	{
		isOpen = false;
		StateHasChanged();
	}

	async Task OpenTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("eval", "document.getElementById('timerDialog').showModal()");
		Close();
	}

	async Task CloseTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("eval", "document.getElementById('timerDialog').close()");
	}

	async Task StartTimerFromDialog()
	{
		var timerDuration = TimeSpan.FromMinutes(timerMinutes);
		if (timerDuration > TimeSpan.Zero)
			Dispatcher.Dispatch(new StartTimerAction(timerDuration));
		await CloseTimerDialog();
	}

	void StopTimer()
	{
		Dispatcher.Dispatch(new SetIsTimeRunningAction(false));
		Close();
	}

	void ShowQrCode()
	{
		Dispatcher.Dispatch(new ShowQrCodeAction());
		Close();
	}

	void HideQrCode()
	{
		Dispatcher.Dispatch(new HideQrCodeAction());
		Close();
	}
}