@page "/playlists"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<Features.Playlists.State> State

<PageTitle>Minstrel - Playlists</PageTitle>

<div id="day-playlist">
	<h2>Day Playlist</h2>
	<PlayableList Playlist="State.Value.DayPlaylist"/>
</div>

<div id="night-playlist">
	<h2>Night Playlist</h2>
	<PlayableList Playlist="State.Value.NightPlaylist"/>
</div>

<div id="other-songs">
	<h2>Other Songs</h2>
	<table>
		<thead>
		<tr>
			<td>Artist</td>
			<td>Title</td>
			<td>Album</td>
			<td>Length</td>
		</tr>
		</thead>
		<tbody>
		@foreach (var song in Database)
		{
			<tr>
				<td>@song.Artist</td>
				<td>@song.Title</td>
				<td>@song.Album</td>
				<td>@song.Length.ToSongLength()</td>
			</tr>
		}
		</tbody>
	</table>
	
</div>

@code {
	List<Song>? Database => State.Value.Database?.ToList();
}
