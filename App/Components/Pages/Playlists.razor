@page "/playlists"
@using Features.Playlists
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<State> State
@inject IDispatcher Dispatcher

<PageTitle>Minstrel - Playlists</PageTitle>

<div id="day-playlist">
	<div class="playlist-header">
		<h2>Day Playlist</h2>
		<button
			class="shuffle"
			@onclick="() => ShufflePlaylist(GamePhase.Day)"
			title="Shuffle day playlist">
			⇄
		</button>
	</div>
	<PlaylistControl
		Playlist="State.Value.DayPlaylist"
		SongMoved="e => MoveSong(GamePhase.Day, e.OldIndex, e.NewIndex)"
		SongRemoved="e => RemoveSong(GamePhase.Day, e.Song)"/>
</div>

<div id="night-playlist">
	<div class="playlist-header">
		<h2>Night Playlist</h2>
		<button
			class="shuffle"
			@onclick="() => ShufflePlaylist(GamePhase.Night)"
			title="Shuffle night playlist">
			⇄
		</button>
	</div>
	<PlaylistControl
		Playlist="State.Value.NightPlaylist"
		SongMoved="e => MoveSong(GamePhase.Night, e.OldIndex, e.NewIndex)"
		SongRemoved="e => RemoveSong(GamePhase.Night, e.Song)"/>
</div>

<div id="other-songs">
	<div class="playlist-header">
		<h2>Other Songs</h2>
		@if (Database is not null)
		{
			<input type="search" placeholder="Search…" @bind="search" @bind:event="oninput"/>
		}
	</div>
	@if (Database is null)
	{
		<p>Loading...</p>
	}
	else
	{
		<table class="song-table">
			<thead>
			<tr>
				<th>Artist</th>
				<th>Title</th>
				<th class="col-album">Album</th>
				<th class="col-length">Length</th>
				<th></th>
			</tr>
			</thead>
			<tbody>
			@foreach (var song in FilteredDatabase)
			{
				<tr>
					<td>@song.Artist</td>
					<td>@song.Title</td>
					<td class="col-album">@song.Album</td>
					<td class="col-length">@song.Length.ToSongLength()</td>
					<td>
						<button class="icon-btn" title="Add to day playlist"
						        @onclick="() => AddSongToPlaylist(GamePhase.Day, song)">☀
						</button>
						<button class="icon-btn" title="Add to night playlist"
						        @onclick="() => AddSongToPlaylist(GamePhase.Night, song)">☾
						</button>
					</td>
				</tr>
			}
			</tbody>
		</table>
	}
</div>

@code {
	string search = "";

	List<Song>? Database => State.Value.Database?.ToList();

	IEnumerable<Song> FilteredDatabase => Database!.Where(s =>
		s.Artist.Contains(search, StringComparison.OrdinalIgnoreCase)
		|| s.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
		|| s.Album.Contains(search, StringComparison.OrdinalIgnoreCase));

	void AddSongToPlaylist(GamePhase gamePhase, Song song)
		=> Dispatcher.Dispatch(new AddSongAction(gamePhase, song));

	void MoveSong(GamePhase gamePhase, int oldIndex, int newIndex)
		=> Dispatcher.Dispatch(new MoveSongAction(gamePhase, oldIndex, newIndex));

	void RemoveSong(GamePhase gamePhase, Song song)
		=> Dispatcher.Dispatch(new RemoveSongAction(gamePhase, song));

	void ShufflePlaylist(GamePhase gamePhase)
		=> Dispatcher.Dispatch(new ShufflePlaylistAction(gamePhase));

}
