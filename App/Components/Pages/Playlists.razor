@page "/playlists"
@using Features.Playlists
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<State> State
@inject IDispatcher Dispatcher

<PageTitle>Minstrel - Playlists</PageTitle>

<div id="day-playlist">
	<h2>Day Playlist</h2>
	<PlaylistControl
		Playlist="State.Value.DayPlaylist"
		SongMoved="e => MoveSong(GamePhase.Day, e.OldIndex, e.NewIndex)"
		SongRemoved="e => RemoveSong(GamePhase.Day, e.Song)"/>
</div>

<div id="night-playlist">
	<h2>Night Playlist</h2>
	<PlaylistControl
		Playlist="State.Value.NightPlaylist"
		SongMoved="e => MoveSong(GamePhase.Night, e.OldIndex, e.NewIndex)"
		SongRemoved="e => RemoveSong(GamePhase.Night, e.Song)"/>
</div>

<div id="other-songs">
	<h2>Other Songs</h2>
	@if (Database is null)
	{
		<p>Loading...</p>
	}
	else
	{
		<table class="song-table">
			<thead>
			<tr>
				<th>Artist</th>
				<th>Title</th>
				<th>Album</th>
				<th>Length</th>
				<th></th>
			</tr>
			</thead>
			<tbody>
			@foreach (var song in Database)
			{
				<tr>
					<td>@song.Artist</td>
					<td>@song.Title</td>
					<td>@song.Album</td>
					<td>@song.Length.ToSongLength()</td>
					<td>
						<button class="icon-btn" title="Add to day playlist" @onclick="() => AddSongToPlaylist(GamePhase.Day, song)">☀</button>
						<button class="icon-btn" title="Add to night playlist" @onclick="() => AddSongToPlaylist(GamePhase.Night, song)">☾</button>
					</td>
				</tr>
			}
			</tbody>
		</table>
	}
</div>

@code {
	List<Song>? Database => State.Value.Database?.ToList();

	void AddSongToPlaylist(GamePhase gamePhase, Song song)
		=> Dispatcher.Dispatch(new AddSongAction(gamePhase, song));
	
	void MoveSong(GamePhase gamePhase, int oldIndex, int newIndex)
		=> Dispatcher.Dispatch(new MoveSongAction(gamePhase, oldIndex, newIndex));
	
	void RemoveSong(GamePhase gamePhase, Song song)
		=> Dispatcher.Dispatch(new RemoveSongAction(gamePhase, song));
}
