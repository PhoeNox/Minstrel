@page "/playlists"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<Features.Playlists.State> State

<PageTitle>Minstrel - Playlists</PageTitle>

<div id="day-playlist">
	<h2>Day Playlist</h2>
	<PlayableList Playlist="State.Value.DayPlaylist"/>
</div>

<div id="night-playlist">
	<h2>Night Playlist</h2>
	<PlayableList Playlist="State.Value.NightPlaylist"/>
</div>

<div id="other-songs">
	<h2>Other Songs</h2>
	@if (Database is null)
	{
		<p>Loading...</p>
	}
	else
	{
		<table class="song-table">
			<thead>
			<tr>
				<th>Artist</th>
				<th>Title</th>
				<th>Album</th>
				<th>Length</th>
				<th></th>
			</tr>
			</thead>
			<tbody>
			@foreach (var song in Database)
			{
				<tr>
					<td>@song.Artist</td>
					<td>@song.Title</td>
					<td>@song.Album</td>
					<td>@song.Length.ToSongLength()</td>
					<td>
						<button>Add to day</button>
						<button>Add to night</button>
					</td>
				</tr>
			}
			</tbody>
		</table>
	}
</div>

@code {
	List<Song>? Database => State.Value.Database?.ToList();
}
