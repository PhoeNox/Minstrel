@page "/Remote"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Features.GamePhases
@using Features.QrCodeConnection
@using State = Features.GamePhases.State

@inject IDispatcher Dispatcher
@inject IState<State> GamePhaseState
@inject IState<Features.Playlists.State> PlaylistState
@inject IState<Features.Playback.State> PlaybackState
@inject IState<Features.Timer.State> TimerState

<PageTitle>Minstrel - Remote</PageTitle>

<SideMenu @ref="sideMenu"/>

<div id="remote-container">
	<div id="day-phase" class="game-phase-section">
		<VolumeControl @bind-Gain="DayGain"/>

		<PlayableList
			Playlist="PlaylistState.Value.DayPlaylist"
			Class="@(GamePhaseState.Value.Phase == GamePhase.Day ? "active" : string.Empty)"
			SongSelected="song => SelectDaySong(song)"
			SongMoved="e => MoveSong(GamePhase.Day, e.OldIndex, e.NewIndex)"/>

		@if (TimerState.Value.IsRunning)
		{
			<label class="timer">@TimerState.Value.TimeLeft.ToString(@"mm\:ss")</label>
		}
	</div>

	<div class="button-bar">
		<div class="control-buttons">
			@if (PlaybackState.Value.IsPlaying)
			{
				<button
					class="primary"
					disabled="@(!IsSongOnOtherPlaylistAvailable)"
					@onclick="SwitchGamePhase">
					<Icon Name="IconName.BrightnessAltHighFill"/>
					Switch
				</button>
			}
			else
			{
				<button
					class="primary"
					disabled="@(PlaylistState.Value.DayPlaylist.CurrentSong is null
					          || !PlaybackState.Value.LoadedSongs.Contains(PlaylistState.Value.DayPlaylist.CurrentSong))"
					@onclick="Play">
					▶ Play
				</button>
			}
		</div>

		<button class="burger-button" @onclick="ToggleMenu">
			<Icon Name="IconName.List"/>
		</button>
	</div>

	<div id="night-phase" class="game-phase-section">
		<PlayableList
			Playlist="PlaylistState.Value.NightPlaylist"
			Class="@(GamePhaseState.Value.Phase == GamePhase.Night ? "active" : string.Empty)"
			SongSelected="song => SelectNightSong(song)"
			SongMoved="e => MoveSong(GamePhase.Night, e.OldIndex, e.NewIndex)"/>

		<VolumeControl @bind-Gain="NightGain"/>
	</div>
</div>

@code {
	SideMenu? sideMenu;

	bool IsSongOnOtherPlaylistAvailable
	{
		get
		{
			var songOnOtherPlaylist = GamePhaseState.Value.Phase == GamePhase.Day
				? PlaylistState.Value.NightPlaylist.CurrentSong
				: PlaylistState.Value.DayPlaylist.CurrentSong;
			return songOnOtherPlaylist is not null
			       && PlaybackState.Value.LoadedSongs.Contains(songOnOtherPlaylist);
		}
	}

	double DayGain
	{
		get => PlaylistState.Value.DayPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetGainAction(GamePhase.Day, (float) value));
	}

	double NightGain
	{
		get => PlaylistState.Value.NightPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetGainAction(GamePhase.Night, (float) value));
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		Dispatcher.Dispatch(new HideQrCodeAction());
	}

	void SelectDaySong(Song song)
	{
		Dispatcher.Dispatch(
			new Features.Playlists.SetCurrentSongAction(
				GamePhase.Day,
				song,
				PlaylistState.Value.DayPlaylist.CurrentSong));
	}

	void SelectNightSong(Song song)
	{
		Dispatcher.Dispatch(
			new Features.Playlists.SetCurrentSongAction(
				GamePhase.Night,
				song,
				PlaylistState.Value.NightPlaylist.CurrentSong));
	}

	void Play()
		=> Dispatcher.Dispatch(new Features.Playback.PlayAction());

	void SwitchGamePhase()
		=> Dispatcher.Dispatch(new SwitchGamePhaseAction());

	void MoveSong(GamePhase gamePhase, int oldIndex, int newIndex)
		=> Dispatcher.Dispatch(new Features.Playlists.MoveSongAction(gamePhase, oldIndex, newIndex));

	void ToggleMenu()
		=> sideMenu?.Toggle();

}
