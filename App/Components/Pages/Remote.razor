@page "/Remote"
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Filled
@inject AppState AppState
@inject Interactions Interactions

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="DayGain" />

<h4>Day</h4>
<ul>
	@foreach (var song in AppState.Playlists.DayPlaylist.Songs)
	{
		<li>@song.Title</li>
	}
</ul>

@if (firstSongPreloaded)
{
	if (AppState.CurrentSong is null)
	{
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.Play()"
			OnClick="Interactions.StartPlaying">
			Play
		</FluentButton>
	}
	else if (firstSongPreloaded)
	{
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.ArrowRepeatAll()"
			OnClick="Interactions.SwitchGamePhase">
			Switch
		</FluentButton>
	}
}

<h4>Night</h4>
<ul>
	@foreach (var song in AppState.Playlists.NightPlaylist.Songs)
	{
		<li>@song.Title</li>
	}
</ul>

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="NightGain" />

@code {
	bool firstSongPreloaded;

	public double DayGain
	{
		get => AppState.DayGain;
		set => Interactions.SetDayGain(value);
	}

	public double NightGain
	{
		get => AppState.NightGain;
		set => Interactions.SetNightGain(value);
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();

		Interactions.FirstSongPreloaded += () =>
		{
			firstSongPreloaded = true;
			StateHasChanged();
		};
		Interactions.LoadPlaylists();
	}
}