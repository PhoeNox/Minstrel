@page "/Remote"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Features.GamePhases
@using Features.Timer
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Filled
@using State = Features.GamePhases.State

@inject IDispatcher Dispatcher
@inject IState<State> GamePhaseState
@inject IState<Features.Playlists.State> PlaylistState
@inject IState<Features.Playback.State> PlaybackState
@inject IState<Features.Timer.State> TimerState
@inject IDialogService DialogService

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="DayGain"/>

<div>
	<h4>Day</h4>
	<FluentDataGrid Items="DaySongs">
		<SelectColumn SelectMode="DataGridSelectMode.Single" @bind-SelectedItems="CurrentDaySongs"/>
		<PropertyColumn Property="@(s => s.Title)"/>
	</FluentDataGrid>
</div>

@if (PlaybackState.Value.IsPlaying is false
     && PlaylistState.Value.DayPlaylist.CurrentSong is not null
     && PlaybackState.Value.LoadedSongs.Contains(PlaylistState.Value.DayPlaylist.CurrentSong))
{
	<FluentButton
		Appearance="Appearance.Accent"
		IconStart="new Size24.Play()"
		OnClick="Play">
		Play
	</FluentButton>
}

@if (PlaybackState.Value.IsPlaying)
{
	<FluentButton
		Appearance="Appearance.Accent"
		IconStart="new Size24.Pause()"
		OnClick="Pause">
		Pause
	</FluentButton>
}

@if (PlaybackState.Value.IsPlaying && IsSongOnOtherPlaylistAvailable)
{
	<FluentButton
		Appearance="Appearance.Accent"
		IconStart="new Size24.ArrowRepeatAll()"
		OnClick="SwitchGamePhase">
		Switch
	</FluentButton>
}

<div>
	<h4>Night</h4>
	<FluentDataGrid Items="NightSongs">
		<SelectColumn SelectMode="DataGridSelectMode.Single" @bind-SelectedItems="CurrentNightSongs"/>
		<PropertyColumn Property="@(s => s.Title)"/>
	</FluentDataGrid>
</div>

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="NightGain"/>

@if (GamePhaseState.Value.Phase == GamePhase.Day)
{
	@if (TimerState.Value.IsRunning is false)
	{
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.Timer()"
			OnClick="OpenTimerDialog">
			Start Timer
		</FluentButton>
	}
	else
	{
		<FluentLabel>Timer: @TimerState.Value.TimeLeft.ToString(@"mm\:ss")</FluentLabel>
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.Stop()"
			OnClick="StopTimer">
			Stop Timer
		</FluentButton>
	}
}

@code {

	bool IsSongOnOtherPlaylistAvailable
	{
		get
		{
			var songOnOtherPlaylist = GamePhaseState.Value.Phase == GamePhase.Day
				? PlaylistState.Value.NightPlaylist.CurrentSong
				: PlaylistState.Value.DayPlaylist.CurrentSong;
			return songOnOtherPlaylist is not null
			       && PlaybackState.Value.LoadedSongs.Contains(songOnOtherPlaylist);
		}
	}

	double DayGain
	{
		get => PlaylistState.Value.DayPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetDayGainAction((float) value));
	}

	double NightGain
	{
		get => PlaylistState.Value.NightPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetNightGainAction((float) value));
	}

	public IQueryable<Song> DaySongs => PlaylistState.Value.DayPlaylist.Songs.AsQueryable();

	public IEnumerable<Song> CurrentDaySongs
	{
		get
		{
			var currentDaySong = PlaylistState.Value.DayPlaylist.CurrentSong;
			return currentDaySong is null ? [] : [currentDaySong];
		}
		set
		{
			var currentDaySong = value.FirstOrDefault();
			if (currentDaySong is not null)
				Dispatcher.Dispatch(new Features.Playlists.SetCurrentSongForDayAction(currentDaySong));
		}
	}

	public IQueryable<Song> NightSongs => PlaylistState.Value.NightPlaylist.Songs.AsQueryable();

	public IEnumerable<Song> CurrentNightSongs
	{
		get
		{
			var currentNightSong = PlaylistState.Value.NightPlaylist.CurrentSong;
			return currentNightSong is null ? [] : [currentNightSong];
		}
		set
		{
			var currentNightSong = value.FirstOrDefault();
			if (currentNightSong is not null)
				Dispatcher.Dispatch(new Features.Playlists.SetCurrentSongForNightAction(currentNightSong));
		}
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		Dispatcher.Dispatch(new Features.Playlists.LoadPlaylistsAction());
	}

	void Play()
		=> Dispatcher.Dispatch(new Features.Playback.PlayAction());

	void Pause()
		=> Dispatcher.Dispatch(new Features.Playback.PauseAction());

	void SwitchGamePhase()
		=> Dispatcher.Dispatch(new SwitchGamePhaseAction());

	async Task OpenTimerDialog()
	{
		var dialogOptions = new DialogParameters
		{
			Title = "Start Timer",
			PrimaryAction = "Start Timer",
		};

		var dialog = await DialogService.ShowDialogAsync<TimerDialog>(
			new TimerDialog.Result {Minutes = 8}, dialogOptions);
		var result = await dialog.Result;
		if (result is {Cancelled: false, Data: TimerDialog.Result dialogResult})
		{
			var timerDuration = TimeSpan.FromMinutes(dialogResult.Minutes);
			if (timerDuration > TimeSpan.Zero)
				Dispatcher.Dispatch(new Features.Timer.StartTimerAction(timerDuration));
		}
	}

	void StopTimer()
		=> Dispatcher.Dispatch(new SetIsTimeRunningAction(false));

}