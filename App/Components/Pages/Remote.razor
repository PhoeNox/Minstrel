@page "/Remote"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@using Features.GamePhases
@using Features.QrCodeConnection
@using Features.Timer
@using State = Features.GamePhases.State

@inject IDispatcher Dispatcher
@inject IState<State> GamePhaseState
@inject IState<Features.Playlists.State> PlaylistState
@inject IState<Features.Playback.State> PlaybackState
@inject IState<Features.Timer.State> TimerState
@inject IState<Features.QrCodeConnection.State> QrCodeConnectionState
@inject IJSRuntime JsRuntime

<div class="side-menu @(isMenuOpen ? "open" : "")">
	@if (GamePhaseState.Value.Phase == GamePhase.Day)
	{
		@if (TimerState.Value.IsRunning is false)
		{
			<button @onclick="() => { OpenTimerDialog(); CloseMenu(); }">⏱ Start Timer</button>
		}
		else
		{
			<label>Timer: @TimerState.Value.TimeLeft.ToString(@"mm\:ss")</label>
			<button @onclick="() => { StopTimer(); CloseMenu(); }">⏹ Stop Timer</button>
		}
	}

	@if (QrCodeConnectionState.Value.QrCodeVisibility != QrCodeVisibility.Hidden)
	{
		<button @onclick="() => { HideQrCode(); CloseMenu(); }">⧉ Hide QR Code</button>
	}
	else
	{
		<button @onclick="() => { ShowQrCode(); CloseMenu(); }">⧉ Show QR Code</button>
	}
</div>

<div id="remote-container">
	<div id="day-phase" class="game-phase-section">
		<VolumeControl Class="volume-control" @bind-Gain="DayGain"/>

		<PlaylistControl
			Playlist="PlaylistState.Value.DayPlaylist"
			SongSelected="song => SelectDaySong(song)"
			SongMoved="e => MoveDaySong(e.OldIndex, e.NewIndex)"/>
	</div>

	<div class="control-buttons">
		@if (PlaybackState.Value.IsPlaying is false
				 && PlaylistState.Value.DayPlaylist.CurrentSong is not null
				 && PlaybackState.Value.LoadedSongs.Contains(PlaylistState.Value.DayPlaylist.CurrentSong))
		{
			<button @onclick="Play">▶ Play</button>
		}

		@if (PlaybackState.Value.IsPlaying)
		{
			<button @onclick="Pause">⏸ Pause</button>
		}

		@if (PlaybackState.Value.IsPlaying && IsSongOnOtherPlaylistAvailable)
		{
			<button @onclick="SwitchGamePhase">🔄 Switch</button>
		}

		<button class="burger-button" @onclick="ToggleMenu">⋯</button>
	</div>

	<div id="night-phase" class="game-phase-section">
		<PlaylistControl
			Playlist="PlaylistState.Value.NightPlaylist"
			SongSelected="song => SelectNightSong(song)"
			SongMoved="e => MoveNightSong(e.OldIndex, e.NewIndex)"/>

		<VolumeControl Class="volume-control" @bind-Gain="NightGain"/>
	</div>
</div>

<dialog id="timerDialog">
	<h3>Start Timer</h3>
	<div>
		<label for="timerMinutes">Minutes</label>
		<input type="number" id="timerMinutes" min="1" @bind="timerMinutes" style="width: 150px"/>
	</div>
	<div>
		<button @onclick="StartTimerFromDialog">Start Timer</button>
		<button @onclick="CloseTimerDialog">Cancel</button>
	</div>
</dialog>

@code {
	private int timerMinutes = 8;
	private bool isMenuOpen = false;

	void ToggleMenu() => isMenuOpen = !isMenuOpen;
	void CloseMenu() => isMenuOpen = false;

	bool IsSongOnOtherPlaylistAvailable
	{
		get
		{
			var songOnOtherPlaylist = GamePhaseState.Value.Phase == GamePhase.Day
				? PlaylistState.Value.NightPlaylist.CurrentSong
				: PlaylistState.Value.DayPlaylist.CurrentSong;
			return songOnOtherPlaylist is not null
			       && PlaybackState.Value.LoadedSongs.Contains(songOnOtherPlaylist);
		}
	}

	double DayGain
	{
		get => PlaylistState.Value.DayPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetDayGainAction((float) value));
	}

	double NightGain
	{
		get => PlaylistState.Value.NightPlaylist.Gain;
		set => Dispatcher.Dispatch(new Features.Playlists.SetNightGainAction((float) value));
	}

	void SelectDaySong(Song song)
	{
		Dispatcher.Dispatch(
			new Features.Playlists.SetCurrentSongForDayAction(
				song,
				PlaylistState.Value.DayPlaylist.CurrentSong));
	}

	void SelectNightSong(Song song)
	{
		Dispatcher.Dispatch(
			new Features.Playlists.SetCurrentSongForNightAction(
				song,
				PlaylistState.Value.NightPlaylist.CurrentSong));
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		if (!PlaylistState.Value.PlaylistsLoaded)
			Dispatcher.Dispatch(new Features.Playlists.LoadPlaylistsAction());
		Dispatcher.Dispatch(new HideQrCodeAction());
	}

	void Play()
		=> Dispatcher.Dispatch(new Features.Playback.PlayAction());

	void Pause()
		=> Dispatcher.Dispatch(new Features.Playback.PauseAction());

	void SwitchGamePhase()
		=> Dispatcher.Dispatch(new SwitchGamePhaseAction());

	async Task OpenTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("eval", "document.getElementById('timerDialog').showModal()");
	}

	async Task CloseTimerDialog()
	{
		await JsRuntime.InvokeVoidAsync("eval", "document.getElementById('timerDialog').close()");
	}

	async Task StartTimerFromDialog()
	{
		var timerDuration = TimeSpan.FromMinutes(timerMinutes);
		if (timerDuration > TimeSpan.Zero)
			Dispatcher.Dispatch(new StartTimerAction(timerDuration));
		await CloseTimerDialog();
	}

	void MoveDaySong(int oldIndex, int newIndex)
		=> Dispatcher.Dispatch(new Features.Playlists.MoveDaySongAction(oldIndex, newIndex));
	
	void MoveNightSong(int oldIndex, int newIndex)
		=> Dispatcher.Dispatch(new Features.Playlists.MoveNightSongAction(oldIndex, newIndex));

	void StopTimer()
		=> Dispatcher.Dispatch(new SetIsTimeRunningAction(false));

	void ShowQrCode()
		=> Dispatcher.Dispatch(new ShowQrCodeAction());

	void HideQrCode()
		=> Dispatcher.Dispatch(new HideQrCodeAction());

}