@page "/Remote"
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Filled
@inject AppState AppState
@inject Interactions Interactions

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="DayGain" />

<div>
	<h4>Day</h4>
	<FluentDataGrid Items="DaySongs">
		<SelectColumn SelectMode="DataGridSelectMode.Single" @bind-SelectedItems="CurrentDaySongs"/>
		<PropertyColumn Property="@(s => s.Title)"/>
	</FluentDataGrid>
</div>

@if (firstSongPreloaded)
{
	if (AppState.CurrentSong is null)
	{
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.Play()"
			OnClick="Interactions.StartPlaying">
			Play
		</FluentButton>
	}
	else if (firstSongPreloaded)
	{
		<FluentButton
			Appearance="Appearance.Accent"
			IconStart="new Size24.ArrowRepeatAll()"
			OnClick="Interactions.SwitchGamePhase">
			Switch
		</FluentButton>
	}
}

<div>
	<h4>Night</h4>
	<FluentDataGrid Items="NightSongs">
		<SelectColumn SelectMode="DataGridSelectMode.Single" @bind-SelectedItems="CurrentNightSongs"/>
		<PropertyColumn Property="@(s => s.Title)"/>
	</FluentDataGrid>
</div>

<FluentSlider Min="0" Max="2" Step="0.1" @bind-Value="NightGain" />

@code {
	bool firstSongPreloaded;

	public double DayGain
	{
		get => AppState.DayGain;
		set => Interactions.SetDayGain(value);
	}

	public double NightGain
	{
		get => AppState.NightGain;
		set => Interactions.SetNightGain(value);
	}
	
	public IQueryable<Song> DaySongs => AppState.Playlists.DayPlaylist.Songs.AsQueryable();

	private Song[] currentDaySongs = [];
	public IEnumerable<Song> CurrentDaySongs
	{
		get => currentDaySongs;
		set
		{
			currentDaySongs = value.ToArray();
			Interactions.SetDaySong(value.First());
		}
	}

	public IQueryable<Song> NightSongs => AppState.Playlists.NightPlaylist.Songs.AsQueryable();

	private Song[] currentNightSongs = [];
	public IEnumerable<Song> CurrentNightSongs
	{
		get => currentNightSongs;
		set
		{
			currentNightSongs = value.ToArray();
			Interactions.SetNightSong(value.First());
		}
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();

		Interactions.FirstSongPreloaded += () =>
		{
			firstSongPreloaded = true;
			StateHasChanged();
		};
		Interactions.LoadPlaylists();
	}
}