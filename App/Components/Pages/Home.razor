@page "/"
@using KristofferStrube.Blazor.WebAudio
@using Playlists = Core.Playlists
@inject IJSRuntime JsRuntime
@inject AppState AppState
@inject Interactions Interactions

<PageTitle>Blood on the Clocktower - Player</PageTitle>

<img src="Images/BloodOnTheClocktower.jpg" alt="Blood on the Clocktower"/>

@code {
	string currentSongPath = string.Empty;

	AudioContext context = null!;
	AudioDestinationNode destination = null!;

	readonly Dictionary<string, Task<AudioBuffer>> preloadedSongs = new();
	readonly Dictionary<string, (GainNode GainNode, AudioBufferSourceNode SongNode)> activeNodes = new();

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		context = await AudioContext.CreateAsync(JsRuntime);
		destination = await context.GetDestinationAsync();

		Interactions.OnPlaylistsLoaded += playlists => _ = PreloadFirstSong(playlists);
		Interactions.OnPlaybackChanged += () => _ = PlayCurrentSong();

		await PlayCurrentSong();
	}

	private async Task PreloadFirstSong(Playlists playlists)
	{
		var songPath = playlists.DayPlaylist.Songs[0].Path;
		var preloadTask = Preload(songPath);
		preloadedSongs.Add(songPath, preloadTask);
		await preloadTask;
		Interactions.NotifyPreloaded();
	}

	private async Task PlayCurrentSong()
	{
		if (activeNodes.TryGetValue(currentSongPath, out var nodes))
			_ = FadeoutAndDispose(nodes.GainNode, nodes.SongNode);

		if (AppState.CurrentSong is null)
			return;

		currentSongPath = AppState.CurrentSong.Path;

		if (!preloadedSongs.ContainsKey(currentSongPath))
			preloadedSongs.Add(currentSongPath, Preload(currentSongPath));

		var nextSongBuffer = await preloadedSongs[currentSongPath];

		var currentSongNode = await context.CreateBufferSourceAsync();
		await currentSongNode.SetBufferAsync(nextSongBuffer);
		
		var currentGainNode = await context.CreateGainAsync();
		var gain = await currentGainNode.GetGainAsync();
		await gain.SetValueAsync(0);
		
		await currentSongNode.ConnectAsync(currentGainNode);
		await currentGainNode.ConnectAsync(destination);

		activeNodes[currentSongPath] = (currentGainNode, currentSongNode);

		if (AppState.CurrentSongStarted is null)
		{
			await currentSongNode.StartAsync();
		}
		else
		{
			var delay = (DateTime.Now - AppState.CurrentSongStarted.Value).TotalSeconds;
			await currentSongNode.StartAsync(offset: delay);
		}
		
		_ = FadeIn(currentGainNode);

		PreloadAndStore(AppState.NextSong?.Path);
		PreloadAndStore(AppState.SongOnOtherPlaylist?.Path);
	}
	
	void PreloadAndStore(string? path)
	{
		if (string.IsNullOrEmpty(path))
			return;
		
		if (!preloadedSongs.ContainsKey(path))
		{
			var preloadTask = Preload(path);
			preloadedSongs.Add(path, preloadTask);
		}
	}
	
	private async Task<AudioBuffer> Preload(string path)
	{
		var buffer = await File.ReadAllBytesAsync(path);
		var audioBuffer = await context.DecodeAudioDataAsync(buffer);
		return audioBuffer;
	}
	
	private async Task FadeoutAndDispose(GainNode gainNode, AudioBufferSourceNode songNode)
	{
		var currentTime = await context.GetCurrentTimeAsync();
		
		var gain = await gainNode.GetGainAsync();
		await gain.LinearRampToValueAtTimeAsync(0, currentTime + 5);
		await Task.Delay(5000);

		await songNode.StopAsync();
		
		await gainNode.DisposeAsync();
		await songNode.DisposeAsync();
	}
	
	private async Task FadeIn(GainNode gainNode)
	{
		var currentTime = await context.GetCurrentTimeAsync();
		
		var gain = await gainNode.GetGainAsync();
		await gain.LinearRampToValueAtTimeAsync(1, currentTime + 5);
		await Task.Delay(5000);
	}
}