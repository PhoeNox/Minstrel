@page "/"

@using Features.QrCodeConnection
@using PinguApps.Blazor.QRCode
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<Features.GamePhases.State> GamePhaseState
@inject IState<Features.Timer.State> TimerState
@inject IState<State> QrCodeConnectionState

<PageTitle>Minstrel - Player</PageTitle>

<AudioPlayer/>

<div class="full-page-container">
	<img
		src="Images/Blood on the Clocktower.webp"
		alt="Blood on the Clocktower"
		class="full-page-image @BackgroundClasses"/>
</div>

@if (TimerState.Value.IsRunning)
{
	<div class="timer-container">
		<div class="timer-box">
			<span class="timer-label">@TimerState.Value.TimeLeft.ToString(@"mm\:ss")</span>
		</div>
	</div>
}

@if (QrCodeConnectionState.Value.QrCodeVisibility == QrCodeVisibility.Visible)
{
	<QRCode Data="@QrCodeConnectionState.Value.ConnectionString" Size="20rem" />
}

@code {
	string BackgroundClasses
		=> GamePhaseState.Value.Phase == GamePhase.Night ? "night-mode" : string.Empty;
}
