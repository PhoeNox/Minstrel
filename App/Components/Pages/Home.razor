@page "/"
@inject AppState AppState
@inject Interactions Interactions
@inject PlaybackService PlaybackService

<PageTitle>Blood on the Clocktower - Player</PageTitle>

<div class="full-page-container">
	<img 
		src="Images/BloodOnTheClocktower.jpg"
		alt="Blood on the Clocktower"
		class="full-page-image @backgroundClasses"/>
</div>

@code {
	private string backgroundClasses = string.Empty;
	
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		await PlaybackService.Initialize();
		
		Interactions.PlaylistsLoaded += async playlists =>
		{
			await PlaybackService.SongRepository.Load(playlists.DayPlaylist.Songs[0]);
			Interactions.NotifyPreloaded();
		};

		Interactions.SongOnOtherPlaylistChanged += async () =>
		{
			await PlaybackService.SongRepository.Load(AppState.SongOnOtherPlaylist!);
		};
		
		Interactions.PlaybackChanged += () => _ = PlayCurrentSong();
		Interactions.GamePhaseChanged += UpdateImage;
		Interactions.GainChanged += async gain => await PlaybackService.SetGain(gain);

		PlaybackService.SongEnded += Interactions.PlayNextSong;

		await PlayCurrentSong();
	}

	private void UpdateImage(GamePhase gamePhase)
	{
		backgroundClasses = gamePhase == GamePhase.Night ? "night-mode" : string.Empty;
		InvokeAsync(StateHasChanged);
	}

	private async Task PlayCurrentSong()
	{
		if (AppState.CurrentSong is null
				|| AppState.NextSong is null
				|| AppState.SongOnOtherPlaylist is null)
			return;

		var gain = GetCurrentGain();
		var fadeInTask = PlaybackService.PlaySong(AppState.CurrentSong, gain);

		var loadNextSongTask = PlaybackService.SongRepository.Load(AppState.NextSong);
		var loadSongOnOtherPlaylistTask = PlaybackService.SongRepository.Load(AppState.SongOnOtherPlaylist);
		
		await Task.WhenAll(fadeInTask, loadNextSongTask, loadSongOnOtherPlaylistTask);
	}
	
	private float GetCurrentGain()
		=> AppState.GamePhase == GamePhase.Day ? AppState.DayGain : AppState.NightGain;
}