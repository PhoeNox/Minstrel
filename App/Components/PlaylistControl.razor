<div class="playlist-control">
	<table>
		<thead>
		<tr>
			<th></th>
			<th>Title</th>
			<th>Artist</th>
			<th>Length</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var song in Playlist.Songs)
		{
			<tr>
				<td>
					<input type="radio"
					       checked="@(Playlist.CurrentSong == song)"
					       @onchange="@(() => SongSelected.InvokeAsync(song))"/>
				</td>
				<td>@song.Title</td>
				<td>@song.Artist</td>
				<td>@ToSongLength(song.Length)</td>
			</tr>
		}
		</tbody>
	</table>
</div>

@code {
	[Parameter] public required Playlist Playlist { get; set; }

	[Parameter] public EventCallback<Song> SongSelected { get; set; }

	static string ToSongLength(TimeSpan timeSpan)
		=> $"{(int) timeSpan.TotalMinutes}:{timeSpan.Seconds:D2}";

}