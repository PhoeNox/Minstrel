@using Features.Playback
@using Infrastructure.FileSystem
@using Infrastructure.Playback

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject PlaybackService PlaybackService
@inject IPlaylistLoader PlaylistLoader
@inject IDispatcher Dispatcher
@inject ILocalStorageService LocalStorage

@code {

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		await PlaybackService.Initialize();

		SubscribeToAction<LoadSongSignal>(s => _ = PlaybackService.SongRepository.Load(s.Song));

		SubscribeToAction<PlaySongSignal>(s => _ = PlaybackService.PlaySong(s.Song, s.Gain));
		SubscribeToAction<PauseSongSignal>(s => _ = PlaybackService.PauseSong(s.Song, s.Reset));
		SubscribeToAction<PlaySoundSignal>(s => _ = PlaybackService.PlaySound(s.Song, s.Gain));

		SubscribeToAction<SetGainSignal>(s => _ = PlaybackService.SetGain(s.Song, s.Gain));

		PlaybackService.SongEnded += s => Dispatcher.Dispatch(new SongEndedSignal(s));
		PlaybackService.SongRepository.SongLoaded += s => Dispatcher.Dispatch(new SongLoadedSignal(s));

		PlaylistLoader.LocalStorage = LocalStorage;

		Dispatcher.Dispatch(new Features.Playlists.LoadPlaylistsAction());
	}

}
