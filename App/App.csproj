<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Bootstrap" Version="3.5.0"/>
		<PackageReference Include="PinguApps.Blazor.QRCode" Version="1.1.4"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Features\Features.csproj"/>
		<ProjectReference Include="..\Infrastructure.Playback\Infrastructure.Playback.csproj"/>
	</ItemGroup>

	<ItemGroup>
	  <None Include="Music\**\*"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest"
	  />
	  <None Include="*.m3u"
	  		CopyToOutputDirectory="PreserveNewest"
	  		CopyToPublishDirectory="PreserveNewest"
	  />
	</ItemGroup>
</Project>
